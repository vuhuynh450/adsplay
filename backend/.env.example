PORT=3000
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
MAX_UPLOAD_SIZE_MB=2048
# Enables HLS-only packaging (FFmpeg stream copy) for accepted videos.
# When false, video uploads keep their original MP4 source and are served directly.
MEDIA_TRANSCODE_ENABLED=true
RESUMABLE_CHUNK_SIZE_MB=8
